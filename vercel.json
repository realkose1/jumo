{
  "buildCommand": "mkdir -p ota && (node scripts/build-ota.mjs > ota/log.txt 2>&1 || echo 'OTA BUILD FAILED — 원격 번들 미갱신' >> ota/log.txt)",
  "installCommand": "echo 'no dependencies needed for web deploy'",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/ota/:path*",
      "destination": "/ota/:path*"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/cheer-status.json",
      "destination": "/cheer-status.json"
    },
    {
      "source": "/cheer/:path*",
      "destination": "/cheer/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/cheer-status.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=30"
        }
      ]
    },
    {
      "source": "/cheer/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/cheer",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/cheer/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/cheer/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
